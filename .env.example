# ======================================================
# Factory Ops — 環境變數範例
# 複製此檔為 .env 並填入實際值
# .env 已列入 .gitignore，絕對不可 commit 真實 secret
# ======================================================

# ── MongoDB ──────────────────────────────────────────
# Docker Compose 內部使用 mongo:27017，本機開發用 localhost:27017
MONGO_HOST_PORT=27017

# ── NATS ─────────────────────────────────────────────
NATS_HOST_PORT=4222
NATS_MONITOR_PORT=8222

# ── MinIO ─────────────────────────────────────────────
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
# PRODUCTION: 使用強密碼（至少 12 字元，含大小寫英數符號）
MINIO_ROOT_PASSWORD=<change-me-strong-password>
MINIO_BUCKET=factory-ops-attachments

# ── Backend ───────────────────────────────────────────
BACKEND_HOST_PORT=8080

# CORS origins — 逗號分隔，不含結尾斜線
# PRODUCTION: 必須設定為實際前端 origin，留空或 "*" 會導致 prod 啟動失敗（S-010）
CORS_ORIGINS=http://localhost:5173

# HR 整合模式（ADR-0014）: mock | h2 | external
#   mock     - 寫死 5 筆 dev 員工
#   h2       - 從 test_data/hr_employees.csv 載入 H2 in-memory DB（推薦 demo / QA）
#   external - 真實 HR REST API（暫未實作）
HR_MODE=mock
# 僅當 HR_MODE=h2 才生效；可用容器絕對路徑或工作目錄相對路徑
HR_H2_CSV_PATH=test_data/hr_employees.csv

# JWT RSA key 檔案路徑（容器內絕對路徑或 classpath: 前綴）
# PRODUCTION: 使用 openssl 產生的 2048-bit RSA key pair
#   openssl genrsa -out privateKey.pem 2048
#   openssl rsa -in privateKey.pem -pubout -out publicKey.pem
# 掛載至容器後填入路徑
JWT_PUBLIC_KEY_PATH=<path-to-production-public-key.pem>
JWT_PRIVATE_KEY_PATH=<path-to-production-private-key.pem>

# ── S-016: Account lockout ────────────────────────────
# 連續登入失敗幾次後鎖定帳號（預設 5）
AUTH_LOCKOUT_THRESHOLD=5
# 鎖定持續分鐘數（預設 15）
AUTH_LOCKOUT_DURATION_MINUTES=15

# ── S-015: Auth rate limiting ─────────────────────────
# 速率限制滑動窗口秒數（預設 60）
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# 登入：每 IP 每窗口最大請求數（預設 100）
AUTH_RATE_LIMIT_LOGIN_PER_IP=100
# 登入：每帳號每窗口最大請求數（預設 10）
AUTH_RATE_LIMIT_LOGIN_PER_ACCOUNT=10
# 登出 / 改密碼：每 IP 每窗口最大請求數（預設 30）
AUTH_RATE_LIMIT_OTHER_PER_IP=30
# 登出 / 改密碼：每帳號每窗口最大請求數（預設 5）
AUTH_RATE_LIMIT_OTHER_PER_ACCOUNT=5

# Swagger UI（production 建議關閉）
SWAGGER_ENABLED=false

# ── Frontend ──────────────────────────────────────────
FRONTEND_HOST_PORT=5173
# docker-compose build 時 bake 進 image，透過 nginx proxy 轉發
VITE_API_BASE_URL=/api/v1
